<Window x:Class="DemoOCR.Views.SnipOverlayWindow"
        Icon="{StaticResource ApplicationIcon}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DemoOCR - 截图"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Black"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        Focusable="True"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp">
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- 1. 冻结的屏幕原始截图底图 (自适应填满 WPF 虚拟屏幕) -->
        <Image x:Name="FreezeImage" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- 2. 半透明遮罩层 (挖空选区) -->
        <Path x:Name="MaskPath" Fill="#70000000">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry x:Name="ScreenGeometry" />
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry x:Name="SelectionGeometry" />
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>

        <!-- 3. 选区边框与四角指示器 -->
        <Canvas x:Name="OverlayCanvas">
            <!-- 选区主外边框 -->
            <Rectangle x:Name="SelectionBorder"
                       Stroke="#0078D7"
                       StrokeThickness="2"
                       Fill="Transparent"
                       Visibility="Collapsed" />

            <!-- 选区尺寸标注浮标 (如: 450 × 280) -->
            <Border x:Name="SizeTipBorder"
                    Background="#D9000000"
                    CornerRadius="4"
                    Padding="6,3"
                    Visibility="Collapsed">
                <TextBlock x:Name="SizeTipText"
                           Foreground="#FFFFFF"
                           FontSize="12"
                           FontFamily="Segoe UI, Microsoft YaHei"
                           FontWeight="Medium" />
            </Border>

            <!-- 底部操作悬浮工具栏 (完成 / 复制 / 取消) -->
            <Border x:Name="ActionToolbar"
                    Background="#F0FFFFFF"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="4"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.25" ShadowDepth="2" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource ApplicationIcon}" Width="16" Height="16" Margin="6,0,4,0" />
                    <TextBlock Text="DemoOCR" FontSize="12" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button x:Name="BtnConfirm"
                            Content="✔ 识别 (Enter)"
                            Click="BtnConfirm_Click"
                            Margin="2,0"
                            Padding="8,4"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Background="#0078D7"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand" />
                    <Button x:Name="BtnCopy"
                            Content="📋 复制图片"
                            Click="BtnCopy_Click"
                            Margin="2,0"
                            Padding="8,4"
                            FontSize="12"
                            Background="#F3F3F3"
                            Foreground="#333333"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1"
                            Cursor="Hand" />
                    <Button x:Name="BtnPin"
                            Content="📌 贴图 (F3)"
                            Click="BtnPin_Click"
                            Margin="2,0"
                            Padding="8,4"
                            FontSize="12"
                            Background="#F3F3F3"
                            Foreground="#333333"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1"
                            Cursor="Hand" />
                    <Button x:Name="BtnCancel"
                            Content="✕ 取消 (Esc)"
                            Click="BtnCancel_Click"
                            Margin="2,0"
                            Padding="8,4"
                            FontSize="12"
                            Background="#F3F3F3"
                            Foreground="#666666"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1"
                            Cursor="Hand" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
