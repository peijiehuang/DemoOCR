<Window x:Class="DemoOCR.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DemoOCR.ViewModels"
        xmlns:app="clr-namespace:DemoOCR"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="DemoOCR - 设置"
        Icon="{StaticResource ApplicationIcon}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Width="460"
        Height="554">
    <Window.Resources>
        <!-- 快捷键录制输入框样式 -->
        <Style x:Key="HotkeyBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei" />
            <Setter Property="Background" Value="#F8F9FA" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#0078D7" />
                    <Setter Property="Background" Value="#140078D7" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF"
            BorderBrush="#CCCCCC"
            BorderThickness="1"
            CornerRadius="10"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Opacity="0.3" ShadowDepth="4" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="74" />
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Border Grid.Row="0"
                    Background="#F8F9FA"
                    BorderBrush="#EEEEEE"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <Image Source="{StaticResource ApplicationIcon}" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="{x:Static app:AppInfo.DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center" />
                        <TextBlock Text="设置" FontSize="12" Foreground="#666666" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            Command="{Binding CancelCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#888888"
                            FontSize="13"
                            Padding="12,0"
                            Cursor="Hand" />
                </DockPanel>
            </Border>

            <!-- 中间内容区 -->
            <StackPanel Grid.Row="1" Margin="20,16">
                <!-- 截图识别快捷键 -->
                <TextBlock Text="🔍 截图并识别快捷键:" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6" />
                <TextBox x:Name="TxtOcrHotkey"
                         Text="{Binding OcrHotkeyText, Mode=OneWay}"
                         Style="{StaticResource HotkeyBoxStyle}"
                         IsReadOnly="True"
                         PreviewKeyDown="TxtOcrHotkey_PreviewKeyDown" />
                <TextBlock Text="提示: 单击输入框并按下键盘组合键（如 F1、F4 或 Alt+Q）" FontSize="11" Foreground="#888888" Margin="0,4,0,10" />

                <!-- 截屏复制快捷键 -->
                <TextBlock Text="📋 截屏直接复制快捷键:" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6" />
                <TextBox x:Name="TxtCopyHotkey"
                         Text="{Binding CopyHotkeyText, Mode=OneWay}"
                         Style="{StaticResource HotkeyBoxStyle}"
                         IsReadOnly="True"
                         PreviewKeyDown="TxtCopyHotkey_PreviewKeyDown" />
                <TextBlock Text="提示: 单击输入框并按下键盘组合键（如 F2、Ctrl+F2）" FontSize="11" Foreground="#888888" Margin="0,4,0,10" />

                <!-- 贴图置顶快捷键 -->
                <TextBlock Text="📌 贴图 (置顶固定在屏幕) 快捷键:" FontSize="12" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,6" />
                <TextBox x:Name="TxtPinHotkey"
                         Text="{Binding PinHotkeyText, Mode=OneWay}"
                         Style="{StaticResource HotkeyBoxStyle}"
                         IsReadOnly="True"
                         PreviewKeyDown="TxtPinHotkey_PreviewKeyDown" />
                <TextBlock Text="提示: 剪贴板有图片时贴图，无图片时自动贴最新历史截图 (默认 F3)" FontSize="11" Foreground="#888888" Margin="0,4,0,10" />

                <!-- 贴图历史张数与自动保存配置 -->
                <DockPanel Margin="0,2,0,2">
                    <TextBlock Text="🖼️ 贴图可回溯最近截图张数 (默认 10):" FontSize="12" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="📂 打开保存文件夹" Command="{Binding OpenSaveFolderCommand}" Background="Transparent" BorderThickness="0" Foreground="#0078D7" Cursor="Hand" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBox Text="{Binding MaxHistoryCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Right" FontSize="12" Margin="6,0,0,0" BorderBrush="#CCCCCC" BorderThickness="1" />
                </DockPanel>
                <TextBlock Text="截图将自动保存至「图片/DemoOCR」文件夹，贴图窗口按 ←/→ 或 A/D 即可翻阅历史" FontSize="11" Foreground="#888888" Margin="0,0,0,10" />

                <!-- 交互开关 -->
                <CheckBox IsChecked="{Binding AutoOcrOnSelect, Mode=TwoWay}"
                          Content="鼠标松开后立即自动识别（无需手动点击确认）"
                          FontSize="12"
                          Foreground="#333333"
                          Margin="0,2,0,0" />

                <!-- 开机自启开关 -->
                <CheckBox IsChecked="{Binding AutoStartOnBoot, Mode=TwoWay}"
                          Content="开机自动启动（随 Windows 开机静默常驻系统托盘，默认关闭）"
                          FontSize="12"
                          Foreground="#333333"
                          Margin="0,8,0,0" />
            </StackPanel>

            <!-- 底部保存/取消按钮 -->
            <Border Grid.Row="2"
                    Background="#F8F9FA"
                    BorderBrush="#EEEEEE"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10"
                    Padding="16,8">
                <StackPanel>
                    <TextBlock FontSize="11" Margin="0,0,0,8">
                        <Hyperlink x:Name="GitHubProjectLink"
                                   NavigateUri="{x:Static app:AppInfo.RepositoryUri}"
                                   RequestNavigate="GitHubProjectLink_RequestNavigate">
                            <Run Text="{x:Static app:AppInfo.RepositoryUrl}" />
                        </Hyperlink>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="保存并应用"
                            Command="{Binding SaveCommand}"
                            Width="90"
                            Height="30"
                            Background="#0078D7"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Margin="0,0,8,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="取消"
                            Command="{Binding CancelCommand}"
                            Width="70"
                            Height="30"
                            Background="#FFFFFF"
                            Foreground="#333333"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            FontSize="12"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
