<Window x:Class="DemoOCR.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DemoOCR.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:PinViewModel}"
        Title="DemoOCR - 贴图"
        Icon="{StaticResource ApplicationIcon}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding IsTopmost}"
        Opacity="{Binding Opacity}"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseWheel="Window_MouseWheel">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- 贴图窗口右键上下文功能菜单 -->
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="🔍 OCR 识别此贴图" Command="{Binding OcrCommand}" />
            <MenuItem Header="📋 复制图片 (Ctrl+C)" Command="{Binding CopyCommand}" />
            <MenuItem Header="💾 保存图片 (Ctrl+S)" Command="{Binding SaveCommand}" />
            <Separator />
            <MenuItem Header="⬅ 上一张历史截图 (← / A)" Command="{Binding PreviousHistoryCommand}" />
            <MenuItem Header="➡ 下一张历史截图 (→ / D)" Command="{Binding NextHistoryCommand}" />
            <MenuItem Header="📂 打开截图保存目录" Command="{Binding OpenFolderCommand}" />
            <Separator />
            <MenuItem Header="📌 始终置顶" IsCheckable="True" IsChecked="{Binding IsTopmost, Mode=TwoWay}" />
            <MenuItem Header="🌓 不透明度">
                <MenuItem Header="100%" Command="{Binding SetOpacityCommand}" CommandParameter="1.0" />
                <MenuItem Header="85%" Command="{Binding SetOpacityCommand}" CommandParameter="0.85" />
                <MenuItem Header="70%" Command="{Binding SetOpacityCommand}" CommandParameter="0.7" />
                <MenuItem Header="50%" Command="{Binding SetOpacityCommand}" CommandParameter="0.5" />
            </MenuItem>
            <Separator />
            <MenuItem Header="✕ 关闭贴图 (Esc / 双击)" Command="{Binding CloseCommand}" />
        </ContextMenu>
    </Window.ContextMenu>
    <Grid Margin="8">
        <Border x:Name="CardBorder"
                Background="#11000000"
                BorderBrush="#440078D7"
                BorderThickness="1"
                CornerRadius="4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Opacity="0.35" ShadowDepth="2" />
            </Border.Effect>
            <Grid ClipToBounds="True">
                <!-- 贴图图像 -->
                <Image Source="{Binding Image}" Stretch="Uniform" />

                <!-- 悬浮操作/缩放/历史翻页提示浮标 (操作时平滑浮现) -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#CC000000"
                        CornerRadius="4"
                        Padding="10,6"
                        Visibility="{Binding IsZoomTipVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ZoomTipText}"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI, Microsoft YaHei" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
